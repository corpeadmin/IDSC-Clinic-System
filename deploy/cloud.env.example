# Copy settings into the hosting dashboard; do not commit actual values.
# This is a Django + hosted PostgreSQL profile. Replace example domains first.
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=your-backend.onrender.com,your-frontend.vercel.app
TRUST_PROXY_HTTPS=1
SERVE_STATIC=True
REQUIRE_OWNER_BEFORE_SERVING=True
# First cloud startup only. Enter these privately, then remove them after setup.
INITIAL_OWNER_USERNAME=
INITIAL_OWNER_PASSWORD=
INITIAL_OWNER_EMAIL=
CLINIC_DATA_BACKEND=database
CLINIC_EMPTY_START=0
MOCK_WORKSPACES_ENABLED=True
REGISTRAR_BACKEND=mock
INVENTORY_BACKEND=mock
# Mock providers remain process-local; run exactly one instance/worker.
# Do not select durable_mock on an ephemeral filesystem.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=verify-full
# Upload the provider CA as a private hosting secret file if required.
# DB_SSLROOTCERT=/etc/secrets/provider-ca.crt
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app
PASSWORD_RESET_FRONTEND_URL=https://your-frontend.vercel.app
EMAIL_BACKEND=authentication.email_backends.BrevoEmailBackend
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=
# Verify DEFAULT_FROM_EMAIL in Brevo. Free-address senders may be rewritten by
# Brevo to a compliant provider address. Check actual recipient inbox delivery.
# Local Gmail SMTP remains available via backend/email.env.example.
