erDiagram
    STUDENTS ||--o{ HEALTH_RECORDS : has
    STUDENTS ||--o{ CONSULTATIONS : has
    STUDENTS ||--o{ HEALTH_STATUSES : has

    STUDENTS {
        bigint student_id PK "externally supplied - no identity, no default"
        timestamptz created_at "auto_now_add"
        timestamptz updated_at "auto_now"
    }

    HEALTH_RECORDS {
        bigint health_id PK "GENERATED BY DEFAULT AS IDENTITY"
        bigint student_id FK "ON DELETE CASCADE"
        text allergies "NOT NULL default ''"
        varchar blood_type "varchar(10) NOT NULL default '' - NO db check"
        text medical_history "NOT NULL default ''"
        text medication "NOT NULL default '' - free text, no rx table"
        numeric weight "numeric(5,2) NULL"
        numeric height "numeric(5,2) NULL"
        timestamptz created_at "auto_now_add"
        timestamptz updated_at "auto_now"
    }

    CONSULTATIONS {
        bigint consultation_id PK "GENERATED BY DEFAULT AS IDENTITY"
        bigint student_id FK "ON DELETE CASCADE"
        text consultation "NOT NULL default ''"
        timestamptz visits "NOT NULL default now - field name is plural"
        timestamptz created_at "auto_now_add"
        timestamptz updated_at "auto_now"
    }

    HEALTH_STATUSES {
        bigint status_id PK "GENERATED BY DEFAULT AS IDENTITY"
        bigint student_id FK "ON DELETE CASCADE"
        text health_status "NOT NULL default '' - free text, not an enum"
        timestamptz date "NOT NULL default now"
        timestamptz created_at "auto_now_add"
        timestamptz updated_at "auto_now"
    }

    AUTH_USER {
        integer id PK "identity"
        varchar username UK "varchar(150) UNIQUE"
        varchar password "varchar(128)"
        varchar email "varchar(254)"
        boolean is_staff "NO FK from any clinic table"
        boolean is_superuser "NO FK from any clinic table"
        boolean is_active
        timestamptz last_login "NULLABLE"
        timestamptz date_joined
    }