# Copy values into private backend/.env; never commit actual credentials.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-sender@gmail.com
EMAIL_HOST_PASSWORD=replace-with-a-gmail-app-password
DEFAULT_FROM_EMAIL=your-sender@gmail.com
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173
